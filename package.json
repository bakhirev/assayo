{
  "name": "Assayo",
  "version": "0.1.13",
  "homepage": ".",
  "private": true,
  "dependencies": {
    "mobx": "^6.7.0",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.8.0"
  },
  "scripts": {
    "dev": "vite --port 3006",
    "build:website": "vite build && cd scripts && node add-analytics.js",
    "build:local": "vite build && cd scripts && node remove-hash.js && node add-local.js",
    "build:docker": "vite build",
    "js:check": "npx eslint \"src/**/*.{ts,tsx,js}\"",
    "js:fix": "npx eslint \"src/**/*.{ts,tsx,js}\" --fix",
    "css:check": "npx stylelint \"src/**/*.{css,scss,sass}\"",
    "css:fix": "npx stylelint \"src/**/*.{css,scss,sass}\" --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/stylelint-plugin": "^3.1.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "sass": "^1.57.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^35.0.0",
    "stylelint-order": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
